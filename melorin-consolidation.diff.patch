-++++++          .then((x) => x.open || 0)
-++++++          .catch(() => 0);
-++++++        if (live)
-++++++          setData({
-++++++            summary,
-++++++            attention,
-++++++            orders,
-++++++            health,
-++++++            backups,
-++++++            users,
-++++++            tickets,
-++++++            stores,
