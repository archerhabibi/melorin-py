-+-async def _notify_earned(session: AsyncSession, order: Order, earned: int, before: Tier | None, after: Tier | None) -> None:
-+-    body = f"{earned:,} امتیاز بابت سفارش {order.number} به باشگاه مشتریان شما اضافه شد."
