-+++++export function useList(api: Json, path: string, toast: Toast) {
-+++++  const [rows, setRows] = useState<Rec[]>([]);
-+++++  const [tick, setTick] = useState(0);
-+++++  const call = (p: Json, o = {}) => authFetch(api.base, p, o);
