-+            {id === 'panels' && (api?.pendingPanelReq ?? 0) > 0 && <b className="num mr-1">{api?.pendingPanelReq}</b>}
-+          </>,
-+        ])}
-+      />
-+      <Suspense fallback={<div className="skel h-44" />}>
