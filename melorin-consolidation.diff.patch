-+def capacity_snapshot_of(server_id: Any, view: dict) -> PanelCapacitySnapshot:
-+    """Build the capacity model from the dict ``panel_integrations.capacity.capacity_view`` returns."""
-+    return PanelCapacitySnapshot(
