-+# ---------------------------------------------------------------------------------------------------- attach
-+async def attach_identity(
-+    session: AsyncSession,
-+    user: User,
-+    provider: str,
-+    subject: str,
-+    *,
-+    evidence: rules.Evidence,
-+    data: dict | None = None,
-+    replace: bool = False,
-+    operation: AccountLinkOperation | None = None,
