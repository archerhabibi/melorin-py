-+        text = f"🟢 پنل «{panel.name}» دوباره سالم شد"
-+    elif now == "degraded" and previous == "unhealthy":
-+        text = f"🟠 پنل «{panel.name}» پاسخ می‌دهد ولی بعضی نودها خطا دارند"
-+    else:
-+        return
