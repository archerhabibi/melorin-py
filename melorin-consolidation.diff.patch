-++def tx_out(t: LoyaltyTransaction) -> dict:
-++    return {
-++        "id": t.id,
-++        "kind": t.kind,
-++        "amount": t.amount,
-++        "balance_after": t.balance_after,
-++        "order_id": t.order_id,
-++        "memo": t.memo,
-++        "created_at": t.created_at,
-++    }
-++
