-++        key=f"loyalty:earn:{order.id}",
-++        order_id=order.id,
-++        memo=f"امتیاز سفارش {order.number}",
-++    )
-++    earned += (tx.amount + tx.debt_recovered) if tx else 0
-++    first = program.first_order_bonus > 0 or program.referral_bonus > 0
