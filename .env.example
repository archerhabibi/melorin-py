# Development defaults. Change every secret in staging/production.
# Site default currency: IRT. Store currencies remain explicit and isolated.
MELORIN_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-password
MELORIN_DATABASE_URL=postgresql+asyncpg://melorin:replace-with-a-long-random-password@postgres:5432/melorin
MELORIN_REDIS_URL=redis://redis:6379/0
MELORIN_JWT_SECRET=replace-with-32-plus-random-chars
MELORIN_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
MELORIN_BOT_SERVICE_SECRET=replace-bot-runner-secret
MELORIN_METRICS_TOKEN=replace-with-a-long-metrics-token
MELORIN_HEALTH_TOKEN=replace-with-a-long-health-token
MELORIN_MAIN_BOT_TOKEN=
MELORIN_TELEGRAM_TOKEN=
MELORIN_TELEGRAM_RESELLER_TOKEN=
# Slug of the reseller Store the reseller bot serves (required by telegram_reseller)
MELORIN_STORE_SLUG=
# Multi-store mode: JSON array [{\"token\":\"...\",\"store_slug\":\"...\"}].
# When set, it replaces the single-token variables above.
MELORIN_RESELLER_BOTS_JSON=
MELORIN_GOOGLE_CLIENT_ID=
# Website login approved in the Telegram bot: request lifetime (60-600 s) and number-matching anti-phishing check
MELORIN_TELEGRAM_WEB_LOGIN_TTL_SECONDS=180
MELORIN_TELEGRAM_WEB_LOGIN_NUMBER_MATCH=true
MELORIN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MELORIN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
MELORIN_SEED_DEMO_DATA=false
MELORIN_STORE_WEB_URL=http://localhost:3000
# Fixed public API origin used for payment callbacks. HTTPS is required outside development.
MELORIN_PUBLIC_API_URL=http://localhost:8000
MELORIN_DOMAIN=localhost
MELORIN_ADMIN_DOMAIN=admin.localhost
MELORIN_BACKUP_DIR=./var/backups
MELORIN_BACKUP_RECIPIENT_FILE=./secrets/backup-recipients.txt
# Off-site (S3) backup and SMTP are OPTIONAL and are configured in the Admin panel (Settings -> Integrations).
MELORIN_BACKUP_OFFSITE_URI=
MELORIN_BACKUP_RETENTION_DAYS=30

# Production safety: mock providers must remain disabled; Redis is required for coordinated limits.
MELORIN_ALLOW_MOCK_PROVIDERS=false
MELORIN_REQUIRE_REDIS_RATE_LIMIT=true
# Exact proxy networks trusted to supply X-Forwarded-For. Compose uses 172.28.0.0/16.
MELORIN_TRUSTED_PROXY_IPS=["127.0.0.1","::1","172.28.0.0/16"]
# Keep CORS explicit in staging/production. JSON arrays are accepted by settings.
MELORIN_CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
MELORIN_CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
MELORIN_CORS_ALLOW_HEADERS=["Accept","Authorization","Content-Type","Idempotency-Key","X-Bot-Secret","X-Request-ID"]
