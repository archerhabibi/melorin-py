# Development defaults. Change every secret in staging/production.
# Site default currency: IRT. Store currencies remain explicit and isolated.
MELORIN_ENV=development
POSTGRES_PASSWORD=replace-with-a-long-random-password
MELORIN_DATABASE_URL=postgresql+asyncpg://melorin:replace-with-a-long-random-password@postgres:5432/melorin
MELORIN_REDIS_URL=redis://redis:6379/0
MELORIN_JWT_SECRET=replace-with-32-plus-random-chars
MELORIN_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
MELORIN_BOT_SERVICE_SECRET=replace-bot-runner-secret
# Least-privilege runner secrets (>=32 chars, all different; the installer / `melorin.sh update` generate them). Main runner -> main store
# only; reseller runner -> reseller stores only. Once BOTH are set Core retires MELORIN_BOT_SERVICE_SECRET (it then opens nothing), and the
# runner containers no longer load this file: docker-compose.yml passes them only their own secret, the Core URL and (main) the bot token.
MELORIN_MAIN_BOT_SECRET=
MELORIN_RESELLER_BOT_SECRET=
MELORIN_METRICS_TOKEN=replace-with-a-long-metrics-token
MELORIN_HEALTH_TOKEN=replace-with-a-long-health-token
MELORIN_MAIN_BOT_TOKEN=
MELORIN_TELEGRAM_TOKEN=
# Reseller bots are managed from Admin > نمایندگان (tokens live encrypted in the database; no restart needed).
# The three variables below are an optional DEVELOPMENT override and are normally left empty.
MELORIN_TELEGRAM_RESELLER_TOKEN=
MELORIN_STORE_SLUG=
# JSON array [{\"token\":\"...\",\"store_slug\":\"...\"}]; when set it replaces Core-driven mode.
MELORIN_RESELLER_BOTS_JSON=
# Optional legacy fallback. Prefer Admin > Settings > Google login (runtime, no rebuild). See docs/GOOGLE-LOGIN-SETUP.md
MELORIN_GOOGLE_CLIENT_ID=
# Website login approved in the Telegram bot: request lifetime (60-600 s) and number-matching anti-phishing check
MELORIN_TELEGRAM_WEB_LOGIN_TTL_SECONDS=180
MELORIN_TELEGRAM_WEB_LOGIN_NUMBER_MATCH=true
MELORIN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
MELORIN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
# Numeric Telegram ID of the main admin (not the @username; ask @userinfobot). Admin alerts are delivered to it by the main bot.
MELORIN_BOOTSTRAP_ADMIN_TELEGRAM_ID=
MELORIN_SEED_DEMO_DATA=false
MELORIN_STORE_WEB_URL=http://localhost:3000
# Fixed public API origin used for payment callbacks. HTTPS is required outside development.
MELORIN_PUBLIC_API_URL=http://localhost:8000
MELORIN_DOMAIN=localhost
MELORIN_ADMIN_DOMAIN=admin.localhost
MELORIN_BACKUP_DIR=./var/backups
MELORIN_BACKUP_RECIPIENT_FILE=./secrets/backup-recipients.txt
# Off-site (S3) backup and SMTP are OPTIONAL and are configured in the Admin panel (Settings -> Integrations).
MELORIN_BACKUP_OFFSITE_URI=
MELORIN_BACKUP_RETENTION_DAYS=30

# Alert delivery (Alertmanager). Set at least ONE receiver, otherwise alerts are evaluated but delivered nowhere.
# Telegram: create a bot with @BotFather, add it to the ops chat, use the chat id (negative for groups).
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# E-mail (optional alternative / addition): ALERT_SMTP_HOST is host:port, e.g. smtp.example.com:587
ALERT_SMTP_HOST=
ALERT_SMTP_FROM=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Production safety: mock providers must remain disabled; Redis is required for coordinated limits.
MELORIN_ALLOW_MOCK_PROVIDERS=false
MELORIN_REQUIRE_REDIS_RATE_LIMIT=true
# Exact proxy networks trusted to supply X-Forwarded-For. Compose uses 172.28.0.0/16.
MELORIN_TRUSTED_PROXY_IPS=["127.0.0.1","::1","172.28.0.0/16"]
# Keep CORS explicit in staging/production. JSON arrays are accepted by settings.
MELORIN_CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
MELORIN_CORS_ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
MELORIN_CORS_ALLOW_HEADERS=["Accept","Authorization","Content-Type","Idempotency-Key","X-Bot-Secret","X-Request-ID"]

# Optional: build images in CI and pull them on the server instead of building here (see docs/RUNBOOK.md, "registry mode").
# MELORIN_IMAGE_REGISTRY=ghcr.io/<owner>/melorin
# MELORIN_IMAGE_TAG=local

# Automatic reading of card-to-card receipts (docs/20-Card-Receipt-Auto-Verification.md). The customer types nothing.
#   auto      = vision when MELORIN_RECEIPT_OCR_API_KEY is set, otherwise local tesseract (Persian), otherwise manual review
#   vision    = a vision LLM reads the image (most accurate for every bank app; the image is sent to the provider below)
#   tesseract = local and private, but Persian digit accuracy depends on the bank app's font
MELORIN_RECEIPT_OCR_ENGINE=auto
MELORIN_RECEIPT_OCR_API_KEY=
# MELORIN_RECEIPT_OCR_BASE_URL=https://api.anthropic.com
# MELORIN_RECEIPT_OCR_MODEL=claude-haiku-5-5
# These env values are only the fallback: Admin > Settings > "خواندن خودکار رسید (OCR)" overrides them (encrypted key, live test).

# --- Automatic identity verification of resellers (docs/21) ---
# Fully proven applications (bot + domain) approve themselves. OFF by default because it grants a store.
MELORIN_RESELLER_AUTO_APPROVE=false
MELORIN_RESELLER_AUTO_APPROVE_DEBT_LIMIT=0
MELORIN_RESELLER_AUTO_APPROVE_MIN_ACCOUNT_DAYS=7
# Approved stores keep proving domain + bot; after N failed rounds admins are alerted (and the store is suspended if enabled).
MELORIN_RESELLER_RECHECK=true
MELORIN_RESELLER_RECHECK_HOURS=24
MELORIN_RESELLER_RECHECK_FAIL_LIMIT=3
MELORIN_RESELLER_RECHECK_SUSPEND=false
