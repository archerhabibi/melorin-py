From 4cd339c1c5f168e204fd9b736990e3f2cfcf4810 Mon Sep 17 00:00:00 2001
From: Pori Toooni <poritoooni@gmail.com>
Date: Sun, 15 Nov 2026 06:28:47 +0000
Subject: [PATCH 1/2] refactor(audit): mypy gate covers orders, identity,
 reseller with a shrink-only ratchet (r13b)

---
 apps/api/pyproject.toml                       | 25 +++++++++++++++++--
 apps/api/tests/contracts/test_mypy_ratchet.py | 14 +++++++++++
 docs/DECISIONS.md                             |  5 ++++
 3 files changed, 42 insertions(+), 2 deletions(-)
 create mode 100644 apps/api/tests/contracts/test_mypy_ratchet.py

diff --git a/apps/api/pyproject.toml b/apps/api/pyproject.toml
index f0e4ae3..ed8ae5e 100644
--- a/apps/api/pyproject.toml
+++ b/apps/api/pyproject.toml
@@ -29,13 +29,34 @@ line-ending = "lf"
 [tool.mypy]
 # T41: static typing is gated on core + worker + the pure domain and the kernel models; widen `files` as other packages are cleaned up.
 python_version = "3.12"
-files = ["melorin/core", "melorin/worker", "melorin/domain", "melorin/kernel", "melorin/modules/wallet", "melorin/modules/catalog"]
+files = ["melorin/core", "melorin/worker", "melorin/domain", "melorin/kernel", "melorin/modules/wallet", "melorin/modules/catalog",
+         "melorin/modules/orders", "melorin/modules/identity", "melorin/modules/reseller"]
 ignore_missing_imports = true
 follow_imports = "silent"
-# T-W07/T-R09: bodies of unannotated functions are checked too; widen `files` one package at a time (next: orders, identity, reseller).
+# T-W07/T-R09: bodies of unannotated functions are checked too; widen `files` one package at a time (r13: orders, identity, reseller are in scope; files in the ratchet list below still carry known Optional-narrowing errors and may only be removed from it, never added).
 check_untyped_defs = true
 warn_unused_ignores = true
 
+# r13 ratchet: known remaining errors (61 at the time of writing). tests/contracts/test_mypy_ratchet.py forbids growing this list.
+[[tool.mypy.overrides]]
+module = [
+  "melorin.modules.identity.auto_link",
+  "melorin.modules.identity.google",
+  "melorin.modules.identity.service",
+  "melorin.modules.identity.routes.account",
+  "melorin.modules.reseller.auto_approve",
+  "melorin.modules.reseller.auto_verify",
+  "melorin.modules.reseller.bots",
+  "melorin.modules.reseller.recheck",
+  "melorin.modules.reseller.routes.store_profile",
+  "melorin.modules.reseller.routes.applications",
+  "melorin.modules.orders.service.payment",
+  "melorin.modules.orders.service.create",
+  "melorin.modules.orders.router",
+  "melorin.modules.orders.provisioning",
+]
+ignore_errors = true
+
 [tool.pytest.ini_options]
 # T-R05: tests are grouped in sub-folders but still import shared helpers by bare module name (module basenames are unique).
 pythonpath = [".", "tests", "tests/unit", "tests/service", "tests/http", "tests/adapters", "tests/contracts", "tests/postgres"]
diff --git a/apps/api/tests/contracts/test_mypy_ratchet.py b/apps/api/tests/contracts/test_mypy_ratchet.py
new file mode 100644
index 0000000..87da5d2
--- /dev/null
+++ b/apps/api/tests/contracts/test_mypy_ratchet.py
@@ -0,0 +1,14 @@
+"""r13: the mypy error ratchet may only shrink (docs/DECISIONS.md r13b, audit section 8.5)."""
+import tomllib
+from pathlib import Path
+
+MAX_RATCHET = 14  # lower this number whenever a module is cleaned and removed from the override list
+
+
+def test_mypy_ratchet_only_shrinks():
+    cfg = tomllib.loads((Path(__file__).resolve().parents[2] / "pyproject.toml").read_text(encoding="utf-8"))
+    mypy = cfg["tool"]["mypy"]
+    ratchet = [m for o in mypy["overrides"] if o.get("ignore_errors") for m in o["module"]]
+    assert len(ratchet) <= MAX_RATCHET, "do not add modules to the mypy ratchet; fix the typing instead"
+    for pkg in ("orders", "identity", "reseller"):
+        assert f"melorin/modules/{pkg}" in mypy["files"]
diff --git a/docs/DECISIONS.md b/docs/DECISIONS.md
index ec43b52..b8b48a3 100644
--- a/docs/DECISIONS.md
+++ b/docs/DECISIONS.md
@@ -198,3 +198,8 @@ Source: `Melorin_Architecture_Admin_Audit.md` (the project has never been releas
 - **Vulture findings were false positives, now explicit**: `initiator` is the mandatory SQLAlchemy listener argument (renamed `_initiator`); `CursorResult` is named only inside a string `cast`, so it moved under `TYPE_CHECKING`.
 - Kept on purpose (audit §4, §7.6): Payments / Wallet, Orders / Provisioning, Identity / Authentication, PanelOps / Panel Integrations, Event Center / Notifications stay separate.
 - Still open (own PRs, not done here): move `/admin/reports/summary` and `/timeseries` into the analytics contract and switch `AdminSession.tsx` / `Trend.tsx` first; split `PanelAdminsView`, `kit.tsx`, `UpstreamBotFields`, `TicketConversation`, `ReportsView` as pure moves; widen mypy module by module (orders, identity, reseller, payments); drop `modules/admin/router.py` re-exports once no import uses them; split `panelops` files by capability.
+
+## r13b - mypy scope widened to orders, identity, reseller (audit 8.5)
+- **Decision:** orders, identity and reseller are now inside the mypy gate. 14 files that still carry Optional-narrowing errors (61 in total, mostly session.get() results used without a None check, in payment/provisioning/identity-merge paths) sit in an ignore_errors override list.
+- **Why a ratchet and not a mass fix:** these are money and provisioning paths; a blind assert or default value could change behaviour. Each file is cleaned together with a test that proves the None case, then removed from the list.
+- **Rule:** the list may only shrink. tests/contracts/test_mypy_ratchet.py fails if it grows.
-- 
2.43.0


