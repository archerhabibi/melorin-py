+            </Card>
+          );
+        })}
+      </div>
+
+      <div className={`grid gap-6 lg:grid-cols-2 ${dim}`}>
+        <Card title="پرفروش‌ترین محصولات" hint={`بر اساس فروش (${cur})`}>
+          {!data ? (
+            <div className="skel h-40 w-full" />
+          ) : (
+            <HBars rows={productRows} color={SERIES_COLORS[0]} empty="فروشی ثبت نشده" />
