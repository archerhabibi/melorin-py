+      </select>
+      <NoticeLevels call={call} toast={toast} storeId={storeId} writable={writable} onCfg={setCfg} />
+      {storeId && <DigestSwitch call={call} toast={toast} storeId={storeId} cfg={cfg} writable={writable} />}
