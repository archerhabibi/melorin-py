+            تمام
+          </button>
+        }
+      >
+        <p className="text-sm leading-7">
+          {fresh.emailed ? 'لینک به ایمیل او هم فرستاده شد.' : 'ایمیل ارسال نشد؛ لینک را خودتان برای او بفرستید.'}{' '}
+          دعوت‌های قبلی باطل شدند.
