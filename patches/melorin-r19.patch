+            </button>
+            <button className="btn btn-g btn-d !py-1.5 !text-xs" disabled={busy} onClick={disconnect}>
+              <Trash2 size={13} />
+              قطع ارتباط ربات
+            </button>
+          </div>
+        )}
+      </section>
+
+      <section className="card space-y-4 p-4">
+        <h4 className="text-[13px] font-extrabold">متن‌های ربات</h4>
+        {TEXTS.map(([k, label, hint, max]) => (
