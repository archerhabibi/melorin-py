+"""Notification dedup key: ``event_id + recipient + channel`` (architecture review 2026-11-13, section 4.7).
+
+An outbox retry re-runs the handler with the same event id, so the same recipient on the same channel is never notified
+twice, while the same event may still reach the same person on ANOTHER channel. Explicit domain keys keep winning.
+"""
+
+EVENT_ID_FIELD = "_event_id"
+
+
+def notification_key(event_id: str, recipient: str, channel: str) -> str:
+    return f"ev:{event_id}:{recipient}:{channel}"[:200]
+
+
+def effective_key(payload: dict, recipient: str, channel: str) -> str | None:
+    """The key to dedupe on: the payload's own ``dedup_key`` if any, else one derived from the outbox event id; None outside the outbox."""
+    explicit = payload.get("dedup_key")
+    if explicit:
+        return explicit
+    event_id = payload.get(EVENT_ID_FIELD)
+    return notification_key(str(event_id), recipient, channel) if event_id else None
diff --git a/apps/api/melorin/domain/order_rewards.py b/apps/api/melorin/domain/order_rewards.py
new file mode 100644
index 0000000..f011902
--- /dev/null
+++ b/apps/api/melorin/domain/order_rewards.py
@@ -0,0 +1,30 @@
+"""Order reward policy: the ONE written answer to "how do coupon, referral and loyalty combine on an order".
+
+Rules (architecture review 2026-11-13, section 4.6):
+  1. Coupon is a SALE discount. It is already inside ``order.total``; it is never a reward and never stacks as one.
+  2. Referral and loyalty both compute from ``order.total`` (the amount actually charged, i.e. AFTER the coupon).
+     Neither is computed from the list price, so a coupon can not inflate a reward.
+  3. Settlement order is fixed: referral first (attribution + cash commission), loyalty second (points, incl. the
+     referrer's loyalty bonus, which reads the relationship referral already established).
+  4. Refund reverses in the opposite order: loyalty first, then referral.
+  5. Only revenue orders with ``total > 0`` earn anything.
+  6. Every grant carries its own idempotency key; re-running a step is a no-op.
+"""
+
+from enum import StrEnum
+
+
+class RewardEngine(StrEnum):
+    REFERRAL = "referral"
+    LOYALTY = "loyalty"
+
+
+SETTLE_ORDER: tuple[RewardEngine, ...] = (RewardEngine.REFERRAL, RewardEngine.LOYALTY)
+REVERSE_ORDER: tuple[RewardEngine, ...] = tuple(reversed(SETTLE_ORDER))
+
+
+def reward_base(total: int, *, is_revenue: bool) -> int:
+    """The amount rewards are computed from: what the customer paid (coupon already applied); 0 when nothing is earned."""
+    if not is_revenue or total <= 0:
+        return 0
+    return total
diff --git a/apps/api/melorin/domain/order_state.py b/apps/api/melorin/domain/order_state.py
index af8a60f..6ecaa41 100644
--- a/apps/api/melorin/domain/order_state.py
+++ b/apps/api/melorin/domain/order_state.py
@@ -65,3 +65,30 @@ class PaymentStatus(StrEnum):
     FAILED = "failed"
     CANCELLED = "cancelled"
     REFUNDED = "refunded"
+
+
+V = VpnStatus
+VPN_TRANSITIONS: dict[VpnStatus, set[VpnStatus]] = {
+    V.PENDING: {V.PROVISIONING, V.ACTIVE, V.REVOKED, V.ARCHIVED},
+    V.PROVISIONING: {V.ACTIVE, V.PENDING, V.REVOKED, V.ARCHIVED},
+    V.ACTIVE: {V.SUSPENDED, V.EXPIRED, V.LIMITED, V.REVOKED, V.ARCHIVED},
+    V.SUSPENDED: {V.ACTIVE, V.EXPIRED, V.REVOKED, V.ARCHIVED},
+    V.EXPIRED: {V.ACTIVE, V.REVOKED, V.ARCHIVED},  # renewal brings it back
+    V.LIMITED: {V.ACTIVE, V.EXPIRED, V.SUSPENDED, V.REVOKED, V.ARCHIVED},  # quota reset / renewal
+    V.REVOKED: {V.ARCHIVED},
+    V.ARCHIVED: set(),
+}
+
+
+def assert_vpn_transition(src: str, dst: str) -> None:
+    """Guard for account lifecycle changes (renewal, return, recreate, bulk, reconcile). Same state is a no-op."""
+    if src == dst:
+        return
+    if VpnStatus(dst) not in VPN_TRANSITIONS[VpnStatus(src)]:
+        raise InvalidTransition(src, dst)
+
+
+def set_vpn_status(account, dst: VpnStatus) -> None:
+    """The one way to change ``account.status``: checks the lifecycle table, then assigns."""
+    assert_vpn_transition(str(account.status), str(dst))
+    account.status = dst
diff --git a/apps/api/melorin/domain/panel_snapshot.py b/apps/api/melorin/domain/panel_snapshot.py
new file mode 100644
index 0000000..747a2e0
--- /dev/null
+++ b/apps/api/melorin/domain/panel_snapshot.py
@@ -0,0 +1,61 @@
+"""One read model of "how is this panel right now" (health + live metrics + freshness).
+
+The panel row stores the last health check (``health_status``, ``health_detail``, ``last_health_at``) and the last live reading
+(``metrics_snapshot``, ``metrics_snapshot_at``). Both are written by the single per-panel read cycle in the worker. Every screen,
+report and gauge reads them through ``PanelSnapshot`` instead of picking fields out of the row on its own. Pure: duck-typed on
+the row, imports nothing of ours.
+"""
+
+from __future__ import annotations
+
+import datetime as dt
+from dataclasses import dataclass, field
+from typing import Any
+
+from melorin.domain.panel_health import SELLABLE_STATES
+
+
+@dataclass(frozen=True)
+class PanelSnapshot:
+    panel_id: Any
+    name: str
+    health_status: str
+    checked_at: dt.datetime | None
+    last_error: str | None
+    sellable: bool
+    detail: dict = field(default_factory=dict)
+    reading: dict | None = None
+    taken_at: dt.datetime | None = None
+
+    @property
+    def up(self) -> bool | None:
+        return bool(self.reading.get("up")) if self.reading else None
+
+    @property
+    def users_total(self) -> Any:
+        return self.reading.get("users_total") if self.reading else None
+
+    @property
+    def online_users(self) -> Any:
+        return self.reading.get("online_users") if self.reading else None
+
+    def is_fresh(self, now: dt.datetime, window: dt.timedelta) -> bool:
+        return self.taken_at is not None and now - self.taken_at <= window
+
+
+def snapshot_of(panel: Any) -> PanelSnapshot:
+    """Build the view from a ``Panel`` row (or anything with the same attributes)."""
+    detail = panel.health_detail if isinstance(panel.health_detail, dict) else {}
+    reading = panel.metrics_snapshot if isinstance(panel.metrics_snapshot, dict) and panel.metrics_snapshot else None
+    status = panel.health_status or "unknown"
+    return PanelSnapshot(
+        panel_id=panel.id,
+        name=panel.name,
+        health_status=status,
+        checked_at=panel.last_health_at,
+        last_error=panel.last_health_error,
+        sellable=bool(detail.get("sellable", status in SELLABLE_STATES)),
+        detail=detail,
+        reading=reading,
+        taken_at=panel.metrics_snapshot_at,
+    )
