+-    per_user_limit: int | None,
+-    sort_order: int,
+-    is_active: bool,
+-    actor_id: uuid.UUID,
+-    actor_type: str,
+-) -> LoyaltyReward:
+-    """Create (``reward_id`` None) or change a reward of ONE store; a reward id of another store is simply not found."""
+-    if not name.strip():
