+-        last4 = dom.digits_only(card_last4)
+-        if len(last4) != 4:
+-            raise AppError("RECEIPT_CARD_INVALID", "۴ رقم آخر کارت مبدأ را وارد کنید.", 422)
+-        claim["source_card_last4"] = last4
+-    return claim
