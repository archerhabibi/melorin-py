++        source_id=src.id,
++        fingerprint=parsed.fingerprint,
++        serial=parsed.serial,
++        direction=parsed.direction,
++        amount_rial=parsed.amount_rial,
++        balance_rial=parsed.balance_rial,
++        occurred_at=parsed.occurred_at,
++        sender=sender,
++        raw_text=text,
