+        run(p, review(true, ''), 'پرداخت تأیید شد', 'تأیید ناموفق بود');
     },
     reject: async (p: Json) => {
       const reason = await promptDialog('دلیل رد این پرداخت را بنویسید.', { title: 'رد پرداخت', ok: 'رد پرداخت' });
