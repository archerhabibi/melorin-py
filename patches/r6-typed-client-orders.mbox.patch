From 6403e576d068d47c35ee4417d784fdf5a9e46ae3 Mon Sep 17 00:00:00 2001
From: Melorin Dev <dev@melorin.local>
Date: Sat, 14 Nov 2026 17:42:13 +0000
Subject: [PATCH] refactor(admin-ui): order actions use the typed api-client
 (r6 phase 3 step 2)

---
 apps/admin-web/src/OrdersView.tsx | 16 +++++++++++-----
 docs/DECISIONS.md                 |  1 +
 2 files changed, 12 insertions(+), 5 deletions(-)

diff --git a/apps/admin-web/src/OrdersView.tsx b/apps/admin-web/src/OrdersView.tsx
index 24b7ce0..fe44381 100644
--- a/apps/admin-web/src/OrdersView.tsx
+++ b/apps/admin-web/src/OrdersView.tsx
@@ -31,6 +31,7 @@ import {
   tint,
   useRows,
 } from './kit.tsx';
+import { typedClient } from './api.ts';
 import { Badge, confirmDialog, dt, promptDialog, sid } from './ui.tsx';
 import {
   Cell2,
@@ -211,15 +212,20 @@ export default function OrdersView({ api, toast }: { api?: Json; toast: Toast })
       return;
     setBusy(true);
     try {
-      const r = await call(`/api/v1/admin/orders/${o.id}/${kind}`, {
-        method: 'POST',
-        body: JSON.stringify({ reason }),
-      });
+      // typed api-client (same transport rules as authFetch); one literal path per action so the schema checks each body
+      const client = typedClient(api.base);
+      const params = { params: { path: { order_id: o.id } } };
+      const { response: r, error } =
+        kind === 'retry'
+          ? await client.post('/api/v1/admin/orders/{order_id}/retry', params)
+          : kind === 'manual-review'
+            ? await client.post('/api/v1/admin/orders/{order_id}/manual-review', { ...params, body: { reason } })
+            : await client.post('/api/v1/admin/orders/{order_id}/refund', { ...params, body: { reason } });
       if (r.ok) {
         toast(`${label} ثبت شد`);
         await orders.load();
         setSelId(null);
-      } else toast(await errText(r, `${label} ناموفق بود`));
+      } else toast(await errText({ json: async () => error }, `${label} ناموفق بود`)); // the client already consumed the body
     } catch {
       toast('ارتباط با سرور برقرار نشد');
     } finally {
diff --git a/docs/DECISIONS.md b/docs/DECISIONS.md
index 044f139..0ccbf87 100644
--- a/docs/DECISIONS.md
+++ b/docs/DECISIONS.md
@@ -165,3 +165,4 @@ _Merged from the former 12-Change-Log-v1.1.md._
 
 - r5 (phase 4, browser): the Playwright suite (`e2e/`, real Chromium, mocked Core API) passed on a clean server: 26 passed, 2 skipped, including the role matrix, every admin menu route and Store Hub deep links. It runs against the Vite preview builds, not against the Compose stack.
 - r5 (menu, 2026-11-14): bulk operations stays in the `infrastructure` permission area (it changes accounts on the external panel); the menu label is now «عملیات گروهی روی پنل» so the label matches who may use it. The URL slug `bulk-operations` is unchanged.
+- r6 (phase 3, second step, 2026-11-14): Orders actions (retry / manual-review / refund) moved to `typedClient`, one literal path per action so the schema checks each body. The client consumes the response body, so failures read the message from its parsed `error`. Remaining on `authFetch`: Panel Operations and the other views, migrated endpoint by endpoint.
-- 
