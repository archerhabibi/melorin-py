+-/** Circular gauge. value 0..1, tone = ok|wn|bd|in|mu. Children render in the centre. */
+-export function Ring({
+-  value = 0,
+-  size = 56,
+-  stroke = 6,
+-  tone = 'ok',
+-  label,
+-  children,
+-}: {
+-  value?: Json;
+-  size?: Json;
+-  stroke?: Json;
+-  tone?: Json;
+-  label?: Json;
+-  children?: ReactNode;
+-}) {
+-  const r = (size - stroke) / 2,
+-    c = 2 * Math.PI * r,
+-    v = Math.max(0, Math.min(1, value || 0));
+-  return (
+-    <span
+-      className="gauge"
+-      style={{ width: size, height: size }}
+-      role={label ? 'img' : undefined}
+-      aria-label={label}
+-      aria-hidden={label ? undefined : true}
+-    >
+-      <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`}>
+-        <circle className="tr" cx={size / 2} cy={size / 2} r={r} strokeWidth={stroke} />
+-        <circle
+-          className="fg"
+-          cx={size / 2}
+-          cy={size / 2}
+-          r={r}
+-          strokeWidth={stroke}
+-          stroke={`var(--${tone})`}
+-          strokeDasharray={c}
+-          strokeDashoffset={c * (1 - v)}
+-        />
+-      </svg>
+-      <span className="relative grid place-items-center text-center leading-none">{children}</span>
+-    </span>
+-  );
+-}
