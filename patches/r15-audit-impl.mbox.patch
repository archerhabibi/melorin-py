diff --git a/apps/api/pyproject.toml b/apps/api/pyproject.toml
index 5915368..1cc78c9 100644
--- a/apps/api/pyproject.toml
+++ b/apps/api/pyproject.toml
@@ -33,16 +33,10 @@ files = ["melorin/core", "melorin/worker", "melorin/domain", "melorin/kernel", "
          "melorin/modules/orders", "melorin/modules/identity", "melorin/modules/reseller", "melorin/modules/payments"]
 ignore_missing_imports = true
 follow_imports = "silent"
-# T-W07/T-R09: bodies of unannotated functions are checked too; widen `files` one package at a time (r13: orders, identity, reseller are in scope; r14: payments too, with no ratchet entries; files in the ratchet list below still carry known Optional-narrowing errors and may only be removed from it, never added).
+# T-W07/T-R09: bodies of unannotated functions are checked too; widen `files` one package at a time (r13: orders, identity, reseller are in scope; r14: payments too, with no ratchet entries; r15: the ratchet is empty, every module in `files` is clean).
 check_untyped_defs = true
 warn_unused_ignores = true
 
-# r13 ratchet: known remaining errors (r14: only orders.provisioning remains). tests/contracts/test_mypy_ratchet.py forbids growing this list.
-[[tool.mypy.overrides]]
-module = [
-  "melorin.modules.orders.provisioning",
-]
-ignore_errors = true
 
 [tool.pytest.ini_options]
 # T-R05: tests are grouped in sub-folders but still import shared helpers by bare module name (module basenames are unique).
diff --git a/apps/api/tests/contracts/test_mypy_ratchet.py b/apps/api/tests/contracts/test_mypy_ratchet.py
index b86953a..f229118 100644
--- a/apps/api/tests/contracts/test_mypy_ratchet.py
+++ b/apps/api/tests/contracts/test_mypy_ratchet.py
@@ -2,13 +2,13 @@
 import tomllib
 from pathlib import Path
 
-MAX_RATCHET = 1  # lower this number whenever a module is cleaned and removed from the override list
+MAX_RATCHET = 0  # lower this number whenever a module is cleaned and removed from the override list
 
 
 def test_mypy_ratchet_only_shrinks():
     cfg = tomllib.loads((Path(__file__).resolve().parents[2] / "pyproject.toml").read_text(encoding="utf-8"))
     mypy = cfg["tool"]["mypy"]
-    ratchet = [m for o in mypy["overrides"] if o.get("ignore_errors") for m in o["module"]]
+    ratchet = [m for o in mypy.get("overrides", []) if o.get("ignore_errors") for m in o["module"]]
     assert len(ratchet) <= MAX_RATCHET, "do not add modules to the mypy ratchet; fix the typing instead"
     for pkg in ("orders", "identity", "reseller"):
         assert f"melorin/modules/{pkg}" in mypy["files"]
-- 
