+-// Live wall-clock shown next to the date (browser timezone, Persian digits).
+-const timeFmt = new Intl.DateTimeFormat('fa-IR', {
+-  hour: '2-digit',
+-  minute: '2-digit',
+-  second: '2-digit',
+-  hour12: false,
+-});
+-function Clock() {
+-  const [now, setNow] = useState(() => new Date());
+-  useEffect(() => {
+-    const t = setInterval(() => setNow(new Date()), 1000);
+-    return () => clearInterval(t);
+-  }, []);
+-  return (
+-    <time dateTime={now.toISOString()} dir="ltr" className="inline-block tabular-nums">
+-      {timeFmt.format(now)}
+-    </time>
+-  );
+-}
+-const money = (v: Json) => new Intl.NumberFormat('fa-IR').format(v || 0);
+-const moneyByCurrency = (rows: Json) =>
+-  (rows || []).map((x: Json) => `${money(x.amount)} ${x.currency}`).join(' · ') || '۰';
