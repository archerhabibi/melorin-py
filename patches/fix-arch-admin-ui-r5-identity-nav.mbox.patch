+
+export const todayLabel = () =>
+  new Intl.DateTimeFormat('fa-IR-u-ca-persian', {
+    weekday: 'long',
+    day: 'numeric',
+    month: 'long',
+    year: 'numeric',
+  }).format(new Date());
+// Live wall-clock shown next to the date (browser timezone, Persian digits).
+const timeFmt = new Intl.DateTimeFormat('fa-IR', {
+  hour: '2-digit',
+  minute: '2-digit',
