+    ],
+    'مسیر فروش: پنل و سرور ← بسته فروش ← پکیج',
+  ],
+  [
+    'ارتباطات',
+    [
+      ['پیام همگانی', Megaphone, 'broadcasts'],
+      ['مرکز رویداد', BellRing, 'event-center'],
+      ['دکمه‌های تلگرام', Paintbrush, 'button-styles'],
