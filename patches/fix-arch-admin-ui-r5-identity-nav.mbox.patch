+      ['کارهای دستی', ListChecks, 'manual-tasks'],
+    ],
+  ],
+  [
+    'کاتالوگ و بازاریابی',
+    [
+      ['بسته‌های فروش', Layers, 'bundles'],
+      ['محصولات VPN', Boxes, 'products'],
+      ['کوپن‌ها', Percent, 'coupons'],
